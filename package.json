{
    "name": "@tfilo/tope-ui",
    "author": {
        "name": "Tomáš Filo",
        "email": "tfilosk@gmail.com",
        "url": "https://github.com/tfilo/tope-ui"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tfilo/tope-ui.git"
    },
    "version": "0.0.1",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/tope-ui-main.umd.js",
    "module": "./dist/tope-ui-main.es.js",
    "exports": {
        ".": {
            "import": "./dist/tope-ui-main.es.js",
            "require": "./dist/tope-ui-main.umd.js"
        },
        "./style.css": "./dist/tope-ui.css"
    },
    "scripts": {
        "build": "tsc -b && vite build",
        "lint": "eslint './lib/**/*.{js,jsx,ts,tsx}'",
        "lint:fix": "eslint './lib/**/*.{js,jsx,ts,tsx}' --fix",
        "prettier": "prettier './lib/**/*.{js,jsx,ts,tsx,json,md}' --check",
        "prettier:fix": "prettier './lib/**/*.{js,jsx,ts,tsx,json,md}' --write",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test-storybook": "vitest --project=storybook",
        "prepare": "husky"
    },
    "peerDependencies": {
        "@tanstack/react-form": "^1.33.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "dependencies": {
        "date-fns": "4.4.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@heroicons/react": "2.2.0",
        "@rolldown/plugin-babel": "0.2.4",
        "@storybook/addon-a11y": "10.6.1",
        "@storybook/addon-docs": "10.6.1",
        "@storybook/addon-vitest": "10.6.1",
        "@storybook/react-vite": "10.6.1",
        "@tailwindcss/vite": "4.3.3",
        "@types/node": "24.13.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "@vitest/browser-playwright": "4.1.11",
        "@vitest/coverage-v8": "4.1.11",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "eslint-plugin-storybook": "10.6.1",
        "eslint-plugin-tailwindcss": "4.4.0",
        "globals": "17.12.0",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "playwright": "1.63.0",
        "prettier": "3.9.9",
        "storybook": "10.6.1",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vite": "8.3.1",
        "vitest": "4.1.11"
    }
}
