{
    "name": "tope-ui",
    "author": {
        "name": "Tomáš Filo",
        "email": "tfilosk@gmail.com",
        "url": "https://github.com/tfilo/tope-ui"
    },
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/tope-ui-main.umd.js",
    "module": "./dist/tope-ui-main.es.js",
    "exports": {
        ".": {
            "import": "./dist/tope-ui-main.es.js",
            "require": "./dist/tope-ui-main.umd.js"
        },
        "./style.css": "./dist/tope-ui.css"
    },
    "scripts": {
        "build": "tsc -b && vite build",
        "lint": "eslint './**/*.{js,jsx,ts,tsx}'",
        "lint:fix": "eslint './**/*.{js,jsx,ts,tsx}' --fix",
        "prettier": "prettier './**/*.{js,jsx,ts,tsx,json,md}' --check",
        "prettier:fix": "prettier './**/*.{js,jsx,ts,tsx,json,md}' --write",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test-storybook": "vitest --project=storybook",
        "prepare": "husky"
    },
    "dependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@heroicons/react": "^2.2.0",
        "@eslint/js": "^9.39.1",
        "@storybook/addon-a11y": "^10.1.11",
        "@storybook/addon-docs": "^10.1.11",
        "@storybook/addon-vitest": "^10.1.11",
        "@storybook/react-vite": "^10.1.11",
        "@tailwindcss/vite": "^4.1.18",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "@vitest/browser-playwright": "^4.0.16",
        "@vitest/coverage-v8": "^4.0.16",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "eslint-plugin-storybook": "^10.1.11",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "playwright": "^1.57.0",
        "prettier": "^3.7.4",
        "storybook": "^10.2.13",
        "tailwindcss": "^4.1.18",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.46.4",
        "vite": "^7.2.4",
        "vitest": "^4.0.16"
    }
}
